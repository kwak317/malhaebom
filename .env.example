# 실제 키·토큰·secret은 Git에서 제외한 .env 또는 배포 Secret Manager에만 적으세요.
# 이 파일은 변수 이름·설명·비민감 예시만 공유합니다. 키 항목은 빈 값으로 유지합니다.
# 2026-10-10 운영 revision malhaebom-mk2-main-sync-final-1010의 변수 이름과 대조했습니다.
# 운영 값 복사본이 아니며, 로컬 기본값과 선택적인 운영 설정을 함께 안내합니다.

# 프런트엔드 공개 설정. 비워 두면 아래 SUPABASE_* 공개 값으로 Compose 빌드합니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# 같은 Docker Compose로 실행할 때는 비워 두면 Nginx가 API로 프록시합니다.
# Vercel처럼 프런트와 API를 따로 배포할 때만 공개 API URL을 입력합니다.
VITE_API_BASE_URL=
# Compose E2E override에서만 비민감 고정 토큰을 넣습니다. 일반 개발·배포에서는 비웁니다.
VITE_COACHING_DEMO_TOKEN=

# Supabase 인증·비공개 저장소
SUPABASE_URL=https://your-project-ref.supabase.co
# 로컬 Compose에서 API 컨테이너가 호스트의 Supabase에 연결할 때 사용합니다.
SUPABASE_DOCKER_URL=
# Docker 접속 주소와 JWT의 iss 주소가 다를 때 토큰 발급자 주소를 지정합니다.
SUPABASE_JWT_ISSUER=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 배포한 프런트 Origin을 쉼표로 구분합니다.
CORS_ALLOWED_ORIGINS=http://localhost:18080
API_PORT=8000
WEB_PORT=18080

# 민간 공고 검색 공급자. web=기존 웹검색, playmcp=사람인 MCP, playmcp_tavily=사람인 MCP+잡코리아 Tavily.
JOB_SEARCH_PROVIDER=web
TAVILY_API_KEY=
# Compose API의 서버 전용 인증 파일. 실제 값은 .env.playmcp/auth.json에만 둡니다.
PLAYMCP_AUTH_FILE=/run/playmcp/auth.json
# 필요할 때만 인증 디렉터리 경로를 지정합니다. 기본은 ./.env.playmcp입니다.
PLAYMCP_AUTH_DIR=
# Cloud Run에서 GCS 기반 인증 저장소를 사용할 때만 버킷 이름을 설정합니다.
# 비워 두면 위 PLAYMCP_AUTH_FILE을 사용합니다. 인증 파일 내용은 커밋하지 마세요.
PLAYMCP_AUTH_BUCKET=

# LLM과 관측
OPENROUTER_API_KEY=
# 운영 코칭 권장 설정. OpenRouter 키는 위 변수에만 넣고 저장소에 커밋하지 마세요.
COACHING_PROVIDER=openrouter
COACHING_LLM_API_KEY=
COACHING_LLM_MODEL=google/gemini-3.5-flash-lite
COACHING_LLM_BASE_URL=https://openrouter.ai/api/v1
# 비워 두면 OpenRouter 25초, Ollama 180초를 사용합니다.
COACHING_LLM_TIMEOUT_SECONDS=
# timeout·연결 오류·429·5xx 전송 재시도. 총 시도 1~3회.
COACHING_LLM_MAX_TRANSPORT_ATTEMPTS=2
COACHING_LLM_BACKOFF_SECONDS=0.5
COACHING_LLM_MAX_BACKOFF_SECONDS=2.0
# provider가 보고한 한 코칭 요청의 누적 비용 상한(USD)
COACHING_LLM_MAX_COST_USD=0.10
# 로컬 Ollama를 사용할 때는 아래 네 값을 사용합니다. 대화용 instruct 모델을 지정하세요.
# COACHING_PROVIDER=ollama
# COACHING_MODEL=qwen2.5-coder:latest
# COACHING_OLLAMA_URL=http://127.0.0.1:11434
# COACHING_OLLAMA_DOCKER_URL=http://host.docker.internal:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 로컬 Langfuse 주소. Japan Cloud를 쓰면 https://jp.cloud.langfuse.com으로 변경합니다.
LANGFUSE_BASE_URL=http://localhost:3000
# 배포에서 사용하는 호환 변수. BASE_URL이 비어 있을 때만 HOST가 적용됩니다.
LANGFUSE_HOST=
# 설정하면 API 시작 시 이 label을 조회합니다. 운영 승격 전에는 production을 이동하지 않습니다.
LANGFUSE_PROMPT_NAME=
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=60
LANGFUSE_DATASET_NAME=malhaebom-coaching-eval-v2
# 16자 이상. 사용자·연습 ID를 trace에 넣기 전 HMAC 가명화할 때만 사용합니다.
COACHING_OBSERVATION_SALT=
COACHING_PROMPT_VERSION=coaching-user-supplied-v4-verification
COACHING_SKILL_VERSION=interview-coach-v6
# FastAPI가 내부 MCP 조회에만 사용하는 32자 이상의 별도 secret
MCP_INTERNAL_SECRET=
# Streamable HTTP MCP 인증 metadata. 운영은 실제 HTTPS /mcp URL을 사용합니다.
MCP_AUTH_ISSUER_URL=https://your-project-ref.supabase.co/auth/v1
MCP_RESOURCE_SERVER_URL=http://localhost:8000/mcp
# 개발 thin slice에서만 true로 바꾸며 배포 환경에서는 false로 둡니다.
COACHING_MOCK_ENABLED=false
# docker-compose.e2e.yml 전용이며 운영 환경에서는 항상 false/빈 값으로 둡니다.
COACHING_E2E_ENABLED=false
COACHING_E2E_TOKEN=

# STT 분석 Worker
STT_MODEL_NAME=large-v3-turbo
STT_MODEL_LABEL=large-v3-turbo
# 원격 STT Worker를 사용할 때 주소를 설정합니다. 빈 값이면 로컬 모델을 사용합니다.
STT_REMOTE_URL=
# STT 모델 revision 식별자. 필요한 배포/빌드에서만 고정 revision을 지정합니다.
# 이 항목을 채우는 것만으로 모델 다운로드·교체가 수행되지는 않습니다.
STT_MODEL_REVISION=
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=1

# 별도 GPU TTS Worker 주소. 로컬 FastAPI 실행과 Docker 내부 주소를 구분합니다.
TTS_WORKER_URL=http://127.0.0.1:8100
TTS_WORKER_DOCKER_URL=http://host.docker.internal:8100
# TTS Worker 프로세스를 GPU 서버에서 직접 실행할 때 설정합니다.
TTS_WORKER_MODEL_PATH=
TTS_WORKER_SPEAKER=candidate_04_questioner
# FastAPI 프로세스 내부에서 질문 TTS를 로드하는 선택 설정입니다.
QUESTION_TTS_MODEL_PATH=

# 기존 내용 피드백 Worker. 2차 프로젝트 LLM 서비스로 교체하기 전까지 기본 비활성화합니다.
LLM_FEEDBACK_ENABLED=false
LLM_FEEDBACK_OLLAMA_URL=http://127.0.0.1:11434
LLM_FEEDBACK_MODEL=qwen3:8b
LLM_FEEDBACK_TIMEOUT_SECONDS=20
QUESTION_RUBRICS_PATH=configs/feedback/question-rubrics.json

# 서버 전용 공고 검색·분석 설정 (키 값은 로컬 .env에서만 설정)
ALIO_API_KEY=
NCS_API_KEY=
ALIO_RECRUITMENT_API_URL=https://opendata.alio.go.kr/new/odaApiMng/recrutInquiryAjaxList.do
ALIO_API_KEY_PARAM=authKey
MOFE_PUBLIC_INSTITUTION_JOB_API_KEY=
INCHEON_RECRUITMENT_API_KEY=
MOFE_PUBLIC_INSTITUTION_JOB_API_URL=https://apis.data.go.kr/1051000/recruitment/list
JOB_REQUIREMENT_ANALYSIS_PROVIDER=
JOB_REQUIREMENT_ANALYSIS_LLM_API_KEY=
JOB_REQUIREMENT_ANALYSIS_LLM_MODEL=google/gemini-3.5-flash-lite
JOB_REQUIREMENT_ANALYSIS_LLM_BASE_URL=
JOB_REQUIREMENT_ANALYSIS_LLM_TIMEOUT_SECONDS=
JOB_REQUIREMENT_ANALYSIS_OLLAMA_URL=
JOB_REQUIREMENT_ANALYSIS_OLLAMA_DOCKER_URL=
JOB_SEARCH_INTENT_PROVIDER=
JOB_SEARCH_INTENT_LLM_API_KEY=
JOB_SEARCH_INTENT_LLM_MODEL=
JOB_SEARCH_INTENT_LLM_BASE_URL=
JOB_SEARCH_INTENT_LLM_TIMEOUT_SECONDS=
OPENROUTER_REQUIRE_PARAMETERS=false
# 기본 실행은 STT 모델 다운로드 없이 시작; 첫 음성 분석 때 모델 준비
STT_WARMUP_ENABLED=false

# 준비 단계/1차 코칭 자유 대화: DB migration과 Prompt/Skill 배포 후 활성화
PREPARATION_CONVERSATION_ENABLED=false
# 준비 대화의 자유채팅 경로 선택. PREPARATION_CONVERSATION_ENABLED=true일 때 사용합니다.
FREE_CHAT_ENABLED=false
